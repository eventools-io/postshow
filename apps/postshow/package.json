{
  "name": "@eventools/postshow",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Postshow web: public site, current review workspace, and preview of the closed-beta customer-incident direction.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "tsc -b --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "tsc -p e2e/tsconfig.json && playwright test --tsconfig e2e/tsconfig.json",
    "test:e2e:ui": "playwright test --tsconfig e2e/tsconfig.json --ui",
    "clean": "rm -rf dist .turbo node_modules"
  },
  "dependencies": {
    "@eventools/postshow-core": "workspace:*",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@supabase/supabase-js": "^2.112.2",
    "posthog-js": "^1.414.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@eventools/config": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.8.0",
    "happy-dom": "^20.11.2",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "license": "MIT"
}
