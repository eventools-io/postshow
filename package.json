{
  "name": "postshow-oss",
  "private": true,
  "version": "0.0.0",
  "description": "Postshow (postshow.io): the customer-intelligence teammate, by eventools. Open-core monorepo: web app, desktop agent, CLI, MCP server, and engine.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "build": "pnpm -r build && node scripts/prerender-postshow-heads.mjs",
    "build:postshow": "pnpm --filter @eventools/postshow build && node scripts/prerender-postshow-heads.mjs",
    "lint": "pnpm -r --if-present lint",
    "type-check": "pnpm -r type-check",
    "test": "pnpm -r --if-present test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "prettier": "3.6.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  }
}
