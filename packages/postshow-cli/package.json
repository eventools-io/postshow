    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eventools/config": "workspace:*",
    "@eventools/postshow-core": "workspace:*",
    "@types/node": "^22.20.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "exports": {
    "./lib": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/lib.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/eventools-io/postshow.git",
    "directory": "packages/postshow-cli"
  },
  "homepage": "https://postshow.io",
  "bugs": {
