{
  "name": "postshow",
  "version": "0.1.0",
  "author": "Eventools LLC",
  "license": "MIT",
  "description": "The Postshow CLI: setup, local evidence runtime, human review, exports, and MCP access for postshow.io.",
  "keywords": [
    "postshow",
    "customer-incident",
    "customer-intelligence",
    "product-analytics",
    "cli",
    "mcp"
  ],
  "type": "module",
  "bin": {
    "postshow": "./dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "prepack": "pnpm build",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@napi-rs/keyring": "1.3.0",
    "postgres": "^3.4.9",
